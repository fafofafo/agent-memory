# Agent Memory keys template — fill with your own keys, then save as data/.env (chmod 600)
# LLM summarization (digest) — DeepSeek (mainland-China direct); any OpenAI-compatible endpoint works
# DEEPSEEK_API_KEY=sk-xxxx
# Semantic vectors — SiliconFlow BGE-M3 (China) / Jina v3 (international)
# SILICONFLOW_API_KEY=sk-xxxx
# JINA_API_KEY=jina_xxxx
# Optional: encryption
# HERMES_ENCRYPT=off
# HERMES_MASTER_KEY=
